function createQuizForm() {
  const form = FormApp.create(FORM_TITLE);
  form.setIsQuiz(true);
  form.setProgressBar(true);
  form.setShuffleQuestions(true);
  form.setDescription(FORM_DESCRIPTION);
  form.setConfirmationMessage('回答ありがとうございました。「スコアを表示」から採点結果を確認できます。');

  const picked = shuffle(TERMS.slice()).slice(0, Math.min(NUM_QUESTIONS, TERMS.length));

  picked.forEach(function (t, i) {
    const t2m = Math.random() < 0.5; // true: 用語→意味 / false: 意味→用語
    const prompt = t2m
      ? '次の用語の意味として正しいものはどれか。【' + t.term + '】'
      : '次の意味をもつ用語はどれか。【' + t.meaning + '】';
    const key = t2m ? 'meaning' : 'term';

    // 紛らわしい選択肢を同じ分野から優先して作る
    const sameCat = TERMS.filter(function (x) {
      return x.term !== t.term && x.category === t.category;
    });
    const others = TERMS.filter(function (x) {
      return x.term !== t.term && x.category !== t.category;
    });
    const pool = shuffle(sameCat).concat(shuffle(others));
    const correctValue = t[key];
    const optionTexts = shuffle([correctValue].concat(pool.slice(0, 3).map(function (x) { return x[key]; })));

    const item = form.addMultipleChoiceItem();
    item
      .setTitle('Q' + (i + 1) + '. ' + prompt)
      .setChoices(
        optionTexts.map(function (c) {
          return item.createChoice(c, c === correctValue);
        })
      )
      .setPoints(1)
      .setRequired(true);
  });

  Logger.log('==============================');
  Logger.log('回答用URL : ' + form.getPublishedUrl());
  Logger.log('編集用URL : ' + form.getEditUrl());
  Logger.log('==============================');
}

function shuffle(a) {
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const tmp = a[i];
    a[i] = a[j];
    a[j] = tmp;
  }
  return a;
}
